# Chatterbox for the Hexe role-play, copied to chatterbox-tts-api\.env by setup.ps1.
# It listens on Kokoro's port, and its voices are cloned from Kokoro's under the same
# names (chatterbox\voices), so Unity talks to either engine without a change.
PORT=8880
HOST=127.0.0.1
DEVICE=auto
# English only: the multilingual model is larger and slower, and the play is in English.
USE_MULTILINGUAL_MODEL=false
EXAGGERATION=0.6
CFG_WEIGHT=0.4
TEMPERATURE=0.8
VOICE_LIBRARY_DIR=./voices
MODEL_CACHE_DIR=./models
VOICE_SAMPLE_PATH=./voice-sample.mp3
ENABLE_MEMORY_MONITORING=false
